# VARNOX X CRASHER — Web (Vercel)
# Copy to your Vercel project Environment Variables (Production/Preview/Development).

# Neon/Postgres connection string (same shared DB used by the other VARNOX portals)
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Optional overrides (the API has safe built-in defaults)
# OWNER_CODE=your_owner_code
# OWNER_TOKEN_SECRET=your_token_secret
# PREMIUM_KEY=your_master_premium_key
# PREMIUM_MODE=false
# WORKER_SECRET=sqx_worker_...
